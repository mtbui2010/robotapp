  "/agent/cancel": {
   "post": {
    "description": "Stop the robot: cancel every ROS command in flight and end the run.\n\nThis is what the dashboard's Stop button reaches. Closing the WebSocket is\nnot enough on its own — the plan runs in a backend thread that would\notherwise finish the current skill and keep going through the remaining\nsteps. Cancelling is process-wide (one robot per process), so it also stops\na skill started from the CLI or a second client.",
    "operationId": "cancel_run_agent_cancel_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Cancel Run"
   }
  },
  "/agent/listen/{req_id}": {
   "post": {
    "description": "The dashboard's transcript for a pending HRI listen request.\n\nA skill running with ``source='dashboard'`` emits a ``listen`` event over\nthe agent WebSocket and blocks in ``robot_agent.utils.listen_dashboard``;\nthe browser captures the answer and posts it here. 404 once the request has\ntimed out and nothing is waiting any more.",
    "operationId": "answer_listen_agent_listen__req_id__post",
    "parameters": [
     {
      "in": "path",
      "name": "req_id",
      "required": true,
      "schema": {
       "title": "Req Id",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ListenAnswer"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Answer Listen"
   }
  },
  "/agent/listen/{req_id}/audio": {
   "post": {
    "description": "The dashboard's recording for a listen with ``capture='whisper'``.\n\nRaw body (``Content-Type`` audio/webm, audio/ogg, …; empty when nobody\nspoke); ``?note=`` carries the browser's account of an empty recording.\nTranscribed with the 'stt' connection off the event loop.",
    "operationId": "answer_listen_audio_agent_listen__req_id__audio_post",
    "parameters": [
     {
      "in": "path",
      "name": "req_id",
      "required": true,
      "schema": {
       "title": "Req Id",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Answer Listen Audio"
   }
  },
  "/agent/llm-config": {
   "get": {
    "description": "Effective LLM config the planner runs on (explicit /agent/llm-config,\nelse the active 'llm' connection). Secrets are stripped.",
    "operationId": "get_llm_config_agent_llm_config_get",
