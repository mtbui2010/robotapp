  "/agent/{agent_name}/get": {
   "get": {
    "description": "Latest value of a device agent (e.g. ``mobile_pose``), read-only.\n\nUnlike ``POST /skill/<name>`` and ``POST /agent/<name>/send`` this does NOT call\n``begin_run``: a UI polling a pose must never clear a pending cancel.",
    "operationId": "get_from_agent_agent__agent_name__get_get",
